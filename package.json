{
  "name": "oc-plugins",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "tui-invaders": "file:../tui-invaders"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "pack:dry-run": "bun run --filter '*' publish:dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11"
  }
}
